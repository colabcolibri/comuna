# Configuração da Aplicação
PORT=3014
NEXT_PUBLIC_APP_URL="http://localhost:3014"
JWT_SECRET="alumni-super-secret-jwt-key-local-development-2026"

# Banco de Dados PostgreSQL (Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/alumni_db"
# Demo no host: só leitura na app (migrate/seed continuam a escrever).
# DATABASE_READ_ONLY=1

# E-mail Admin Inicial (Seed / SuperAdmin)
INITIAL_SUPER_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_EMAIL="admin@example.com"

# Envio (Mailpit local: docker compose, UI http://localhost:8026)
SMTP_HOST="localhost"
SMTP_PORT=1026
# SMTP_SECURE=none
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM_ADDRESS="auth@alumni.org"

# ObjectStore local (fotos). Pasta na raiz do repo, gitignored.
MEDIA_DRIVER=local
MEDIA_ROOT=
