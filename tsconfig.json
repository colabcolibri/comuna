{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "target": "ES2017",
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@community/db": ["./packages/core/db/src/index.ts"],
      "@community/module-runtime": ["./packages/core/module-runtime/src/index.ts"],
      "@community/auth": ["./packages/core/auth/src/index.ts"],
      "@community/auth/otp-api-error": ["./packages/core/auth/src/otp-api-error.ts"],
      "@community/auth/smtp": ["./packages/core/auth/src/smtp.ts"],
      "@community/auth/session": ["./packages/core/auth/src/session.ts"],
      "@community/identity": ["./packages/core/identity/src/index.ts"],
      "@community/places": ["./packages/core/places/src/index.ts"],
      "vitest": ["./node_modules/vitest"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/admin/**/*.ts",
    "apps/admin/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/.next"]
}
