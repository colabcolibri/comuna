# Copiar para a raiz do clone no VPS: cp deploy/hostinger/env.example .env.hostinger
# Não commitar .env.hostinger. Valores abaixo são sintéticos.

POSTGRES_PASSWORD=trocar-por-senha-longa
JWT_SECRET=trocar-por-segredo-longo
NEXT_PUBLIC_APP_URL=https://comuna.example.com
NEXT_PUBLIC_OPS_URL=https://ops.comuna.example.com
EMAIL_FROM_ADDRESS=auth@comuna.example.com
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com

# SMTP real, ou vazio para não enviar
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASS=

# Demo pública: só leitura na app (migrate/seed sem esta flag)
DATABASE_READ_ONLY=1
ALLOW_DEV_OTP=

# Hosts para o drop-in do Traefik (ficheiro, não labels Docker)
COMUNA_HOST=comuna.example.com
COMUNA_OPS_HOST=ops.comuna.example.com
