#!/usr/bin/env python3
"""Shortcut for meridian_board_serve.py — product root is the folder that contains .agent/."""

from __future__ import annotations

import runpy
import sys
from pathlib import Path

_AGENT = Path(__file__).resolve().parent
_SERVE = _AGENT / "scripts" / "meridian_board_serve.py"
_PACKAGE_ROOT = _AGENT.parent


def main() -> None:
    rest = sys.argv[1:]
    if not rest or rest[0].startswith("-"):
        sys.argv = [str(_SERVE), str(_PACKAGE_ROOT), *rest]
    else:
        sys.argv = [str(_SERVE), *rest]
    runpy.run_path(str(_SERVE), run_name="__main__")


if __name__ == "__main__":
    main()
