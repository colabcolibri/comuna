{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "target": "ES2017",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@community/db": [
        "../../packages/core/db/src/pool.ts"
      ],
      "@community/module-runtime": [
        "../../packages/core/module-runtime/src/is-enabled.ts"
      ],
      "@community/auth": [
        "../../packages/core/auth/src/index.ts"
      ],
      "@community/identity": [
        "../../packages/core/identity/src/pick-content.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
