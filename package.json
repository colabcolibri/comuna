{
  "name": "alumni-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm --filter @community/web dev",
    "dev:admin": "pnpm --filter @community/admin dev",
    "build": "pnpm --filter @community/web build",
    "start": "pnpm --filter @community/web start",
    "lint": "pnpm --filter @community/web exec next lint",
    "test": "vitest run",
    "db:migrate": "node scripts/db-migrate.cjs",
    "db:seed": "node scripts/db-seed.cjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^5.6.3",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "pg": "^8.12.0",
    "postcss": "^8.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2"
  }
